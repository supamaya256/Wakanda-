+  const handleDownloadClick = async (e: React.MouseEvent<HTMLAnchorElement>) => {
+    e.preventDefault();
+    if (downloadState === 'downloading') return;
+
+    setDownloadState('downloading');
+    setDownloadProgress(0);
+    
+    try {
+      // Try to fetch to get real progress
+      const response = await fetch(track.downloadUrl);
+      if (!response.ok) throw new Error('Network response was not ok');
+      
+      const contentLength = response.headers.get('content-length');
+      if (!contentLength) throw new Error('No content length');
+
+      const total = parseInt(contentLength, 10);
+      let loaded = 0;
+
+      const reader = response.body?.getReader();
+      if (!reader) throw new Error('No reader');
+
+      const chunks = [];
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) break;
+        chunks.push(value);
+        loaded += value.length;
+        setDownloadProgress(Math.min(100, Math.round((loaded / total) * 100)));
+      }
+
+      const blob = new Blob(chunks);
+      const url = window.URL.createObjectURL(blob);
+      const a = document.createElement('a');
+      a.href = url;
+      a.download = track.filename;
+      document.body.appendChild(a);
+      a.click();
+      document.body.removeChild(a);
+      window.URL.revokeObjectURL(url);
+      
+      setDownloadState('done');
+      setTimeout(() => setDownloadState('idle'), 3000);
+
+    } catch (err) {
+      console.warn("Real download progress failed, falling back to native", err);
+      downloadTrack(track); // Fallback to context default
+      
+      // Simulate a quick progress to show something happened
+      setDownloadProgress(100);
+      setDownloadState('done');
+      setTimeout(() => setDownloadState('idle'), 3000);
+    }
+  };
+
   return (
